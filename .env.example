FLASK_SECRET_KEY="sdfsdfsjdbf78sdyfssdfsdfbuidfs98gdfsdbf"
FLASK_DEBUG="False"

GOOGLE_API_KEY="your_google_ai_studio_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# Needed ONLY for an identity-linked key, which does not belong to a single
# workspace - such a key is refused with "anthropic-workspace-id is required"
# until this is set. Leave empty for an ordinary workspace API key.
ANTHROPIC_WORKSPACE_ID=""

GEMINI_MODEL_NAME="gemini-3.5-flash"
DEEPSEEK_MODEL_NAME="deepseek-chat"
OPENAI_MODEL_NAME="gpt-4o"
CLAUDE_MODEL_NAME="claude-opus-5"


CORS_ORIGINS="*"


LOG_LEVEL_APP="INFO"
LOG_LEVEL_ERROR="ERROR"
LOG_LEVEL_ACCESS="INFO"
LOG_LEVEL_SECURITY="INFO"

HOST=127.0.0.1
PORT=9000
WORKERS=3

# --- Textbook retrieval (RAG) ------------------------------------------
# Off by default: leave RAG_ENABLED false and the service generates from book
# titles exactly as before, with no database and no extra dependencies used.
RAG_ENABLED=false

# Optional. The portal now pushes each textbook to POST /rag/index when it is
# uploaded, so this service normally never reaches back into the portal. Set a
# value only to also index books that were already on disk before that endpoint
# existed; leave it empty and those books are simply skipped.
PORTAL_BASE_URL=""

# The vector store: one Postgres URL, and nothing else. Nothing in
# docker-compose starts a database any more - point this at whichever server
# holds the index. That database needs the pgvector extension enabled ONCE by
# a superuser, which an ordinary application login cannot do itself:
#
#     CREATE EXTENSION vector;
#
RAG_DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Seconds before an unreachable store is given up on. Retrieval runs inside the
# generate request's own timeout, so failing open has to also fail fast.
RAG_DB_CONNECT_TIMEOUT=8
RAG_DB_STATEMENT_TIMEOUT=20

# text-embedding-004 was retired by Google and now 404s.
RAG_EMBED_MODEL="models/gemini-embedding-001"
RAG_EMBED_BATCH=100

# --- Retrieval shape ---
# The unit's syllabus line is split into its topics and each is searched for
# separately, then every hit is widened to the pages around it. What reaches
# the model is a few readable stretches of the book spread over the whole
# unit, instead of scattered paragraphs clustered on one part of it.
RAG_TOP_K=8          # stretches of book sent to the model
RAG_PER_TOPIC=2       # pages taken per topic before widening
RAG_PAGE_WINDOW=1     # pages kept either side of each hit
RAG_MAX_CHARS=55000   # ceiling on retrieved text per request (~10k tokens)
# Cosine distance past which a hit means "this book does not cover that topic".
# Passing off-topic pages is worse than passing none, because the prompt tells
# the model to base its questions on whatever it is given. Tune this against a
# real indexed textbook - it is the one value here that cannot be guessed well.
RAG_MAX_DISTANCE=0.40
RAG_FETCH_TIMEOUT=60
# Internal portals usually carry a self-signed certificate.
RAG_VERIFY_TLS=false
