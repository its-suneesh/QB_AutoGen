FLASK_SECRET_KEY="your_strong_random_32_byte_secret_key"
FLASK_DEBUG="False"

GOOGLE_API_KEY="your_google_ai_studio_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

GEMINI_MODEL_NAME="gemini-3.5-flash"
DEEPSEEK_MODEL_NAME="deepseek-chat"
OPENAI_MODEL_NAME="gpt-4o"


CORS_ORIGINS="*"


LOG_LEVEL_APP="INFO"
LOG_LEVEL_ERROR="ERROR"
LOG_LEVEL_ACCESS="INFO"
LOG_LEVEL_SECURITY="INFO"

# Where the service listens. Change PORT here and nowhere else -
# run.py, the Dockerfile healthcheck and docker-compose all read it.
# In Docker, HOST must be 0.0.0.0 (docker-compose sets that for you).
# Leave these three unquoted - docker's --env-file keeps quotes literally.
HOST=127.0.0.1
PORT=9000
WORKERS=1
